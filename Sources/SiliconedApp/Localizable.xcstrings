    "Import a LoRA or a full model of a supported family, as .safetensors (at least 8 bits) or .gguf (at least 4 bits)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie eine LoRA oder ein vollständiges Modell einer unterstützten Familie, als .safetensors (mindestens 8 Bit) oder .gguf (mindestens 4 Bit)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un LoRA o un modelo completo de una familia compatible, en .safetensors (8 bits como mínimo) o .gguf (4 bits como mínimo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez une LoRA ou un modèle complet d’une famille connue, en .safetensors (8 bits au moins) ou .gguf (4 bits au moins)."
          }
        },
        "it" : {
