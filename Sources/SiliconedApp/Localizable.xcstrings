        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend avec ce que ce Mac contient — peut-être rien encore. La bibliothèque de l’autre disque n’est pas touchée"
          }
        },
        "it" : {
          "stringUnit" : {
