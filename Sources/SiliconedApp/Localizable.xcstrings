    "The sketches side by side, labelled — an image of the history, in memory like the others" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Skizzen nebeneinander, beschriftet – ein Bild des Verlaufs, im Arbeitsspeicher wie die anderen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bocetos lado a lado, con leyenda — una imagen del historial, en memoria como las demás"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les esquisses côte à côte, légendées — une image de l’historique, en mémoire comme les autres"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli schizzi affiancati, con didascalie — un’immagine della cronologia, in memoria come le altre"
          }
