          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición del %@ se hizo con otro macOS u otra versión de Siliconed: este Mac se mide de nuevo antes del próximo renderizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure du %@ a été prise avec un autre macOS ou une autre version de Siliconed : ce Mac est mesuré à nouveau avant le prochain rendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misura del %@ è stata presa con un altro macOS o un’altra versione di Siliconed: questo Mac viene misurato di nuovo prima del prossimo rendering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
