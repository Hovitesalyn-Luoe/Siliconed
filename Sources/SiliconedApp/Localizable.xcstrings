    "Drag the line, or press ← →, to reveal one image or the other" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linie ziehen oder ← → drücken, um das eine oder das andere Bild zu zeigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la línea, o pulsa ← →, para mostrar una imagen u otra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire glisser la ligne, ou appuyer sur ← →, pour révéler l’une ou l’autre image"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la linea, o premi ← →, per mostrare l’una o l’altra immagine"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动分隔线或按 ← →，以显示其中一张图像"
          }
        }
      }
    },
    "Drag to frame what the model should look at: inside to move, an edge to resize, outside to draw another frame." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um zu rahmen, was das Modell ansehen soll: innen zum Verschieben, an einer Kante zum Ändern der Größe, außen für einen neuen Rahmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para encuadrar lo que el modelo debe mirar: dentro para mover, en un borde para cambiar el tamaño, fuera para trazar otro encuadre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour cadrer ce que le modèle doit regarder : à l’intérieur pour déplacer, sur un bord pour redimensionner, à l’extérieur pour tracer un autre cadre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per inquadrare ciò che il modello deve guardare: all’interno per spostare, su un bordo per ridimensionare, all’esterno per tracciare un’altra cornice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以框出模型应关注的范围：在框内移动，拖动边缘调整大小，在框外绘制新框。"
          }
        }
      }
    },
    "Drag to resize the prompt" : {
