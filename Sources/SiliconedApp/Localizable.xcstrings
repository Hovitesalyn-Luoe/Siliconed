    "Make room — uninstall a model, or discard the interrupted downloads in the Models sheet — then start again: the files already downloaded are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaffen Sie Platz – deinstallieren Sie ein Modell oder verwerfen Sie die unterbrochenen Downloads im Fenster „Modelle“ – und beginnen Sie dann erneut: Bereits geladene Dateien bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz sitio — desinstala un modelo, o descarta las descargas interrumpidas en la hoja Modelos — y vuelve a empezar: los archivos ya descargados se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites de la place — désinstallez un modèle, ou jetez les téléchargements interrompus dans la feuille Modèles — puis recommencez : les fichiers déjà téléchargés sont gardés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera spazio — disinstalla un modello, o scarta i download interrotti nella finestra Modelli — poi ricomincia: i file già scaricati vengono conservati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腾出空间——卸载一个模型，或在「模型」面板中丢弃中断的下载——然后重新开始：已下载的文件会保留。"
          }
        }
      }
    },
