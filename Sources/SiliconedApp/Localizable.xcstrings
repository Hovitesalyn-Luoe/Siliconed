    "Not enough free space on this disk to install it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend freier Platz auf diesem Volume für die Installation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente espacio libre en este disco para instalarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de place libre sur ce disque pour l’installer."
          }
        },
