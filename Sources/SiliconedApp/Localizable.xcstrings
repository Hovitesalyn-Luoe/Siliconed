            "state" : "translated",
            "value" : "Importa una LoRA o un modello completo di una famiglia supportata, in .safetensors (almeno 8 bit) o .gguf (almeno 4 bit)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
