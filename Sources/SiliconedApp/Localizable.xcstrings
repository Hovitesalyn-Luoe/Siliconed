    "Steps are whole numbers from 1, a grid needs at least one seed, and a negative LoRA strength needs Experimental → Negative LoRA Strengths." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte sind ganze Zahlen ab 1, ein Raster braucht mindestens einen Seed, und eine negative LoRA-Stärke braucht Experimentell → Negative LoRA-Stärken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos son números enteros a partir de 1, una cuadrícula necesita al menos una semilla, y una intensidad de LoRA negativa necesita Experimental → Intensidades de LoRA negativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pas sont des nombres entiers à partir de 1, une grille demande au moins une graine, et une force de LoRA négative demande Expérimental → Forces de LoRA négatives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I passi sono numeri interi a partire da 1, una griglia richiede almeno un seme, e un’intensità di LoRA negativa richiede Sperimentale → Intensità LoRA negative."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步数是从 1 开始的整数，网格至少需要一个种子，负的 LoRA 强度需要 实验性 → 负 LoRA 强度。"
          }
        }
      }
    },
