    "Give each axis its values: a group of the prompt, seeds, steps, a LoRA of the stack, models or the edit's images." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie jeder Achse ihre Werte: eine Gruppe des Prompts, Seeds, Schritte, eine LoRA des Stapels, Modelle oder die Bilder der Bearbeitung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a cada eje sus valores: un grupo del prompt, semillas, pasos, un LoRA de la pila, modelos o las imágenes de la edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à chaque axe ses valeurs : un groupe du prompt, des graines, des pas, une LoRA de la pile, des modèles ou les images de l’édition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai a ogni asse i suoi valori: un gruppo del prompt, semi, passi, una LoRA della pila, modelli o le immagini della modifica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
