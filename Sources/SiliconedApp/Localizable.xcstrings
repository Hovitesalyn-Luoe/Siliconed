    "Siliconed Window" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siliconed-Fenster"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventana de Siliconed"
          }
        },
        "fr" : {
          "stringUnit" : {
