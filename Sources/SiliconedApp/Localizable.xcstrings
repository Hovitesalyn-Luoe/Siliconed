        }
      }
    },
    "Not enough room to keep both: the %@ version will be removed before the download (%@ freed). Until the installation is done, %@ cannot render." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug Platz für beide: Die %1$@-Version wird vor dem Download entfernt (%2$@ frei). Bis die Installation abgeschlossen ist, kann %3$@ nicht rendern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not enough room to keep both: the %1$@ version will be removed before the download (%2$@ freed). Until the installation is done, %3$@ cannot render."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay sitio para conservar las dos: la versión %1$@ se eliminará antes de la descarga (se liberan %2$@). Hasta que termine la instalación, %3$@ no podrá renderizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de place pour garder les deux : la version %1$@ sera retirée avant le téléchargement (%2$@ libérés). Jusqu’à la fin de l’installation, %3$@ ne pourra pas rendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio insufficiente per tenerle entrambe: la versione %1$@ verrà rimossa prima del download (%2$@ liberati). Fino al termine dell’installazione, %3$@ non potrà eseguire rendering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空间不足，无法同时保留两者：下载前将移除 %1$@ 版本（释放 %2$@）。安装完成前，%3$@ 无法渲染。"
          }
        }
      }
    },
    "Not everything came back from %@." : {
